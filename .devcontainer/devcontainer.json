{
  "name": "VCMI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "workspaceMount": "source=vcmi-${localWorkspaceFolderBasename},target=/workspace,type=volume",
  "workspaceFolder": "/workspace",
  "initializeCommand": "bash .devcontainer/init-volume.sh",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.1": {},
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // Live bind-mount of host-regenerated .env: runArgs --env-file is frozen at docker-create time, so the bind reflects the file initializeCommand rewrites before each start.
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.env,target=/etc/devcontainer/host.env,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.zshrc,target=/tmp/host-zshrc,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/opencode-auth.json,target=/home/vscode/.local/share/opencode/auth.json,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/opencode-mcp-auth.json,target=/home/vscode/.local/share/opencode/mcp-auth.json,type=bind,consistency=cached",
    "source=ccache-volume,target=/mnt/ccache,type=volume",
    "source=h3-data-volume,target=/mnt/h3-data,type=volume"
  ],
  // hostRequirements = START-GATE / warning only (devcontainer spec). NOT a runtime cap.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "64gb"
  },
  // runArgs --memory = the ACTUAL cgroup enforcement (OOM-kills inside the container). Keep in sync with hostRequirements.memory above.
  // runArgs --cpu-shares = soft work-conserving weight: bounds the container only under contention; bursts to all cores when idle.
  // 512 -> cgroup cpu.weight 59 vs host default 100 on runc >= 1.2 (legacy runc maps it to 20 - same proportional semantics).
  "runArgs": [
    "--memory=8gb",
    "--cpu-shares=512",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
  ],
  // Fix ownership BEFORE installers: the opencode auth/mcp-auth binds make Docker create /home/vscode/.local/... as root-owned;
  // the /mnt/ccache and /mnt/h3-data named volumes must be vscode-owned for their writers.
  // The C++ toolchain comes from apt (postCreateCommand, per docs/developers/Building_Linux.md); opencode stays curl-installed as a
  // self-updating CLI. The symlink puts it on PATH for non-interactive shells (devcontainer exec / agent PTYs don't source rc files;
  // the installer's ~/.opencode/bin is otherwise reachable only interactively).
  "onCreateCommand": "sudo mkdir -p /home/vscode/.local/share/opencode /mnt/ccache /mnt/h3-data && sudo chown -R vscode:vscode /home/vscode/.local /mnt/ccache /mnt/h3-data && curl -fsSL https://opencode.ai/install | bash && sudo ln -sf /home/vscode/.opencode/bin/opencode /usr/local/bin/opencode",
  // Full vcmi build+test deps from docs/developers/Building_Linux.md (Ubuntu), then submodules (googletest for vcmitest,
  // vcmi-dependencies) and a warm configure of the test preset to validate the toolchain end-to-end (soft-fail: slow networks
  // shouldn't block container creation - rerun manually if skipped). ENABLE_MMAI=OFF: Ubuntu 24.04 apt has no onnxruntime
  // (needs 24.10+ / Debian 13+) and MMAI is experimental - see README "NOT included". The unit tests resolve REAL H3 resources
  // (DATA/LCDESC.TXT etc. - same as upstream CI), so the H3 test data is fetched onto the persistent h3-data volume and exposed
  // at ~/.local/share/vcmi via symlink.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.local && sudo apt-get update && sudo apt-get install -y cmake g++ clang libsdl2-dev libsdl2-image-dev libsdl2-ttf-dev libsdl2-mixer-dev zlib1g-dev libavformat-dev libswscale-dev libboost-dev libboost-filesystem-dev libboost-program-options-dev libboost-date-time-dev libboost-iostreams-dev qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools qt6-l10n-tools qt6-svg-dev libtbb-dev libluajit-5.1-dev liblzma-dev libsqlite3-dev libminizip-dev libsquish-dev libfmt-dev ninja-build ccache ripgrep p7zip-full && git submodule update --init --recursive && mkdir -p /home/vscode/.local/share && ln -sfn /mnt/h3-data/vcmi /home/vscode/.local/share/vcmi && { bash .devcontainer/fetch-h3-data.sh || echo 'WARN: H3 test data fetch failed - tests will fail on real resources; rerun .devcontainer/fetch-h3-data.sh'; } && { cmake --preset linux-gcc-test -DENABLE_MMAI=OFF || echo 'WARN: test-preset configure failed - run it manually in the container terminal'; } && cp /tmp/host-zshrc /home/vscode/.zshrc 2>/dev/null; echo 'set -a; . /etc/devcontainer/host.env 2>/dev/null; set +a' >> /home/vscode/.zshrc; echo 'set -a; . /etc/devcontainer/host.env 2>/dev/null; set +a' >> /home/vscode/.bashrc; echo 'alias opencode=\"opencode --auto\"' >> /home/vscode/.zshrc; echo 'alias opencode=\"opencode --auto\"' >> /home/vscode/.bashrc || true",
  // postStart shells do not source rc files, so exports are explicit where needed.
  "postStartCommand": "bash .devcontainer/set-git-identity.sh || true",
  "containerEnv": {
    // Agent shells run under a PTY: git/gh pagers block forever without these.
    "GIT_PAGER": "cat",
    "GH_PAGER": "cat",
    // Workaround for oven-sh/bun#31409 (bun embedded in the opencode SEA
    // corrupts the heap under concurrent GC); harmless once fixed upstream.
    "BUN_JSC_useConcurrentGC": "0",
    // ccache state lives on the ccache-volume named volume so compilation caches survive rebuilds.
    "CCACHE_DIR": "/mnt/ccache",
    // Default mtime-based compiler check misses after toolchain upgrades across rebuilds; content check keeps hits stable.
    "CCACHE_COMPILERCHECK": "content"
    // Claude Code auth rides CLAUDE_CODE_OAUTH_TOKEN from the env staging file
    // (.devcontainer/.env, rewritten by initializeCommand on every start);
    // no config-dir override, so claude uses its writable container-local home.
  },
  "remoteEnv": {
    "PATH": "/usr/local/bin:/home/vscode/.opencode/bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
